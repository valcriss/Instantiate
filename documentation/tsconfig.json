{
  // Shared configuration for documentation type-checking and editor tooling.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "types": ["@docusaurus/module-type-aliases"],
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [".docusaurus", "build"]
}
